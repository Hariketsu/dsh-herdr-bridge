{
  "name": "dsh-herdr-bridge",
  "version": "0.1.2",
  "description": "Bridge DeepSeek Harness (DSH) sessions into Herdr Core as hc terminals",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "render.js",
    "client.js",
    "proxy.js",
    "install.js",
    "assets/dsh.svg",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md"
  ],
  "engines": {
    "node": ">=24.9"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hariketsu/dsh-herdr-bridge.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "herdr",
    "herdr-core",
    "hc",
    "agent"
  ]
}
